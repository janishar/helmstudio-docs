---
// A screen in an app window frame.
interface Props { src: string; alt: string; caption?: string; eager?: boolean }
const { src, alt, caption, eager } = Astro.props;
---
<figure class="not-content" style="margin:0">
  <div class="hs-window">
    <div class="hs-bar" aria-hidden="true"><i></i><i></i><i></i></div>
    <img src={`/screens/${src}.jpg`} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  {caption && <figcaption class="hs-cap">{caption}</figcaption>}
</figure>
